---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import CompareTable from '../components/CompareTable.astro';
import { PRICE_LABEL, comparison } from '../data/site';
---
<Layout
  title="VDIConnect compared with Parsec, Citrix and Microsoft RDP"
  description="Where VDIConnect fits next to Parsec, Citrix and Microsoft Remote Desktop: codec, 4:4:4 colour, monitors, transport, platforms, infrastructure and licensing."
  active="compare"
>
  <section class="section grid-bg">
    <div class="container" style="padding-top: 96px; padding-bottom: 88px">
      <p class="kicker">Compare</p>
      <h1 class="h1 h1--sm" style="max-width: 15ch">Where VDIConnect <span class="slice">fits.</span></h1>
      <p class="lead lead--hero">Parsec, Citrix and Microsoft Remote Desktop each solve remote access their own way. VDIConnect is a display protocol for Windows VDI: one host, one user, every pixel in AV1 — with nothing to deploy between them.</p>
      <div class="grid mt-xl">
        <div class="card card--top stack" style="--gap: 12px">
          <span class="mono small" style="color: var(--red-text)">01</span>
          <h2 class="h3">AV1 from end to end</h2>
          <p class="muted" style="font-size: 15px">Native AV1 4:4:4 keeps coloured and sub-pixel text sharp. Pick 4:2:0 or 4:4:4 at connection time; under pressure the stream steps down and recovers on its own.</p>
        </div>
        <div class="card card--top stack" style="--gap: 12px">
          <span class="mono small" style="color: var(--red-text)">02</span>
          <h2 class="h3">Ultra-low latency on real networks</h2>
          <p class="muted" style="font-size: 15px">An encrypted low-latency transport repairs lost packets as they arrive, without waiting for a resend, and always sends input, cursor and audio ahead of video.</p>
        </div>
        <div class="card card--top stack" style="--gap: 12px">
          <span class="mono small" style="color: var(--red-text)">03</span>
          <h2 class="h3">Nothing to stand up</h2>
          <p class="muted" style="font-size: 15px">No controllers, gateways or VPN. Server on each host, client on each device, and a private overlay network to reach hosts behind NAT. Licenses cost {PRICE_LABEL} per VDI per month, bought online.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container">
      <div class="row row--between" style="align-items: baseline">
        <h2 class="h2" style="margin: 0; font-size: clamp(1.75rem, 3.4vw, 2.5rem)">Side by side</h2>
        <span class="mono small" style="color: var(--dim)">From public vendor documentation · October 2026</span>
      </div>
      <div class="mt-md"><CompareTable groups={comparison} /></div>
      <p class="small" style="margin: 20px 0 0; max-width: 820px; color: var(--dim)">
        Compiled from publicly available vendor documentation in October 2026. Capabilities vary by edition, version, hardware and configuration.
        Parsec, Citrix, Microsoft, Remote Desktop and Azure are trademarks of their respective owners; their mention does not imply endorsement.
      </p>
    </div>
  </section>

  <section class="section grid-bg">
    <div class="container row row--between" style="align-items: center; padding-top: 112px; padding-bottom: 112px">
      <h2 class="h2" style="margin: 0; max-width: 16ch">Try it on your own hosts.</h2>
      <div class="row" style="--gap: 12px">
        <a href="/download/#trial" class="btn btn--primary">Start a 30-day free trial <Icon name="arrow" size={18} strokeWidth={2} /></a>
        <a href="/pricing/" class="btn">Buy licenses</a>
      </div>
    </div>
  </section>
</Layout>
