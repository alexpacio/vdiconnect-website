---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Page not found — VDIConnect" description="The page you were looking for does not exist.">
  <section class="section grid-bg">
    <div class="container">
      <p class="kicker">404</p>
      <h1 class="h1 h1--sm">This page went <span class="slice">offline.</span></h1>
      <p class="lead">The page you were looking for does not exist or has moved.</p>
      <div class="row mt-md"><a href="/" class="btn btn--primary">Back to the home page</a></div>
    </div>
  </section>
</Layout>
