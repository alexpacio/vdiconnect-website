# Copy to .env and fill in. Every value is public (PUBLIC_*) and ends up in the built site.

# Stripe Payment Links for the "VDIConnect VDI license" product (EUR 4.99 per VDI per month).
# Enable "Let customers adjust quantity", Stripe Tax and tax ID collection on both links.
PUBLIC_STRIPE_LINK_MONTHLY=
PUBLIC_STRIPE_LINK_YEARLY=

# PayPal subscription plan links (one plan per billing period).
PUBLIC_PAYPAL_LINK_MONTHLY=
PUBLIC_PAYPAL_LINK_YEARLY=

# Free form service endpoints that accept a standard HTML form POST
# (Formspree, Getform, Basin and similar), e.g. https://formspree.io/f/xxxxxxxx
PUBLIC_TRIAL_FORM_ENDPOINT=
PUBLIC_NOTIFY_FORM_ENDPOINT=

# Free client downloads.
PUBLIC_CLIENT_WINDOWS_URL=
PUBLIC_CLIENT_MACOS_URL=

PUBLIC_SALES_EMAIL=sales@vdiconnect.it
